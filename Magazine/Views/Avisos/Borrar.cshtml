@model Avisos
@{
    ViewData["Title"] = "Borrar Aviso";
}
<h1>Esta seguro de borrar el Aviso del cliente @Model.NombreCliente</h1>
<form asp-action="Borrar" asp-controller="Avisos">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-primary" type="submit">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
