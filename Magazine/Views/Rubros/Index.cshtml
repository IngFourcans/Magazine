@model IEnumerable<Rubros>;
@{
    ViewData["Title"] = "Rubros";
}

<h1>Rubros</h1>

<a asp-action="Crear" class="btn btn-primary mb-3">Agregar</a>
<table class="table">
    <thead>
        <tr>
            <th>Acciones</th>
            <th>Nombre</th>
        </tr>
    </thead>
    <tbody id="reordenable">
        @foreach(var rubros in Model)
        {
        <tr>
            <td>
                <input type="hidden" value="@rubros.Id" class="ids">
                <a class="btn btn-primary" asp-action="Editar" asp-route-id="@rubros.Id">Editar</a>
                <a class="btn btn-danger" asp-action="Borrar" asp-route-id="@rubros.Id">Borrar</a>
            </td>
            <td>@rubros.Rubro</td>
        </tr>
        }
    </tbody>
</table>
@section Scripts
{
    <script>
        const urlOrdenar='@Url.Action("Ordenar")';

        $(function()
        {
            $("#reordenable").sortable({
                stop: async function(e, ui)
                    {
                        await actualizarOrden();
                    }
            });
            async function actualizarOrden() {
                const ids =  ObtenerIdsDeElementos();
                await enviarIdsAlBackEnd(ids);
            }
            function ObtenerIdsDeElementos()
            {
                const ids=$(".ids").map(function(){
                    return $(this).val();}).get();
                return ids;
            }
            async function enviarIdsAlBackEnd(ids)
            {
                var data=JSON.stringify(ids);

                await fetch(urlOrdenar,{
                    method:'POST',
                    body: data,
                    headers:{
                    'Content-Type': 'application/json'}
                });
            }
        })

    </script>
}